{
  "name": "@mete-sirin/deeval",
  "version": "1.0.0",
  "description": "Checks a Node.js or Bun project: runtime version, manifest vs. lockfile, and installed packages",
  "keywords": [
    "lockfile",
    "package.json",
    "dependencies",
    "node",
    "bun",
    "npm",
    "pnpm",
    "yarn",
    "diagnostics",
    "cli"
  ],
  "homepage": "https://github.com/mete-sirin/deeval#readme",
  "bugs": {
    "url": "https://github.com/mete-sirin/deeval/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mete-sirin/deeval.git"
  },
  "author": "Mete Sirin",
  "license": "ISC",
  "type": "module",
  "bin": {
    "deeval": "bin/deeval.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/deeval.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "prepublishOnly": "pnpm test && pnpm typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
